# LLM API Keys
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Alibaba Qwen (通义千问)
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-max

# Baidu Ernie (文心一言)
ERNIE_API_KEY=your-ernie-api-key-here
ERNIE_SECRET_KEY=your-ernie-secret-key-here
ERNIE_MODEL=ernie-bot-4

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Application Settings
APP_NAME=LLM Excel Processor
APP_ENV=development  # development, production
DEBUG=true

# File Processing
MAX_FILE_SIZE=100  # MB
TEMP_DIR=/tmp/llm-excel-processor
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv,.txt,.pdf

# Processing Settings
DEFAULT_BATCH_SIZE=10
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=1000
MAX_CONCURRENT_TASKS=5

# Retry Strategy
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2
REQUEST_TIMEOUT=30  # seconds

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database (Optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/llm_excel_processor
# DATABASE_URL=sqlite:///./llm_excel_processor.db

# Redis (Optional, for task queue)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=logs/app.log

# Security
SECRET_KEY=your-secret-key-for-session-encryption
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Monitoring (Optional)
# SENTRY_DSN=your-sentry-dsn-here

# Features
ENABLE_CACHING=true
CACHE_TTL=3600  # seconds
ENABLE_TELEMETRY=true
ENABLE_API_AUTH=false
